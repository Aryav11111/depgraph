# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO
# false = human-readable console logs; true = one JSON object per line.
LOG_JSON=false

# Used when running the app / tests on the host against the compose services.
DATABASE_URL=postgresql+asyncpg://depgraph:depgraph@localhost:5432/depgraph
REDIS_URL=redis://localhost:6379/0

# Optional overrides consumed by docker-compose.yml.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=8080

# npm registry client (defaults shown). Limits apply per process.
# NPM_REGISTRY_URL=https://registry.npmjs.org
# NPM_TIMEOUT_S=10
# NPM_MAX_CONCURRENCY=16
# NPM_REQUESTS_PER_SECOND=50
# NPM_MAX_RETRIES=4
# NPM_BACKOFF_BASE_S=0.5
# NPM_BACKOFF_MAX_S=30
# NPM_CACHE_FRESH_S=3600
# NPM_CACHE_RETAIN_S=604800
# NPM_NEGATIVE_CACHE_S=300
